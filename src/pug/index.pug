mixin consultButtons(extraClass)
    .consult-actions(class=extraClass)
        a.btn.btn-primary.btn-consult(href=`tel:${companyInfo.primaryPhone}`, data-consult='phone')
            i.fas.fa-phone.me-2
            | 电话咨询
        a.btn.btn-outline-light.btn-consult(href='#contact', data-consult='wechat')
            i.fab.fa-weixin.me-2
            | 微信咨询

mixin equipmentCard(name, type)
    .col-sm-6.col-lg-4.col-xl-3.mb-4
        .equipment-card.h-100
            .equipment-card-body
                .equipment-type= type
                h3.equipment-title= name
                p.equipment-note 具体起重能力请联系确认
            .equipment-card-actions
                a.btn.btn-sm.btn-primary(href=`tel:${companyInfo.primaryPhone}`, data-consult='phone') 电话咨询
                a.btn.btn-sm.btn-outline-secondary(href='#contact', data-consult='wechat') 微信咨询

doctype html
html(lang='zh-CN')

    head

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(http-equiv='X-UA-Compatible', content='IE=edge,chrome=1')
        meta(name='applicable-device', content='pc,mobile')
        meta(name='description', content=seoDescription)
        meta(name='keywords', content=seoKeywords)
        meta(name='author', content=companyInfo.name)
        meta(name='robots', content='index,follow')
        meta(name='Bingbot', content='index,follow')
        meta(name='Sogou web spider', content='index,follow')
        meta(property='og:type', content='website')
        meta(property='og:title', content=seoTitle)
        meta(property='og:description', content=seoDescription)
        meta(property='og:url', content=siteUrl)
        meta(property='og:image', content=socialImage)
        meta(property='og:image:alt', content=`${companyInfo.name}标志`)
        meta(name='twitter:card', content='summary_large_image')
        meta(name='twitter:image', content=socialImage)
        link(rel='canonical', href=siteUrl)

        title= seoTitle

        // Favicon
        link(rel='icon', type='image/x-icon', href='assets/favicon.ico')
        link(rel='icon', type='image/png', sizes='64x64', href=faviconImage)
        link(rel='apple-touch-icon', sizes='180x180', href='assets/apple-touch-icon.png')

        // Font Awesome icons (free version)
        script(src='https://use.fontawesome.com/releases/v6.3.0/js/all.js', crossorigin='anonymous')

        script(type='application/ld+json')!= JSON.stringify(localBusinessSchema)

        // Core theme CSS (includes Bootstrap)
        link(href='css/styles.css?v=20260526-hero-image', rel='stylesheet')

    body#page-top

        // 公司信息配置：联系人、电话、微信、地址、二维码后续在这里替换
        script.
            window.companyInfo = !{JSON.stringify(companyInfo)};

        // Navigation
        nav#mainNav.navbar.navbar-expand-lg.navbar-dark.fixed-top
            .container
                a.navbar-brand(href='#home', aria-label=companyInfo.name)
                    span.navbar-logo-frame
                        img.navbar-logo(src=navLogoImage, width='40', height='40', alt=`${companyInfo.name}标志`)
                    span.brand-mark 敏祥吊装
                button.navbar-toggler(type='button', data-bs-toggle='collapse', data-bs-target='#navbarResponsive', aria-controls='navbarResponsive', aria-expanded='false', aria-label='展开导航')
                    | 导航
                    i.fas.fa-bars.ms-2
                #navbarResponsive.collapse.navbar-collapse
                    ul.navbar-nav.ms-auto.py-4.py-lg-0
                        li.nav-item
                            a.nav-link(href='#home') 首页
                        li.nav-item
                            a.nav-link(href='#crawler-crane') 履带式起重机
                        li.nav-item
                            a.nav-link(href='#truck-crane') 汽车式起重机
                        li.nav-item
                            a.nav-link(href='/lifting-plan') 吊装选型
                        li.nav-item
                            a.nav-link(href='#portfolio') 工程案例
                        li.nav-item
                            a.nav-link(href='#contact') 联系我们

        // Hero
        header#home.masthead
            .masthead-overlay
            .container
                .row.align-items-center
                    .col-lg-9.mx-auto
                        .masthead-kicker= companyInfo.name
                        h1.masthead-heading 重庆履带吊 · 履带吊租赁 · 四川履带吊
                        p.masthead-subheading
                            | 重庆敏祥吊装租赁责任有限公司位于重庆市大渡口区，专注重庆、四川、贵州及周边区县起重机租赁与吊装服务。客户常搜的重庆履带吊、履带吊租赁、四川履带吊和重庆吊车，对应我们提供的履带式起重机租赁、汽车式起重机租赁和大型设备吊装服务，设备覆盖25吨至500吨。
                        .seo-keyword-row(aria-label='主营关键词')
                            span 重庆履带吊
                            span 履带吊租赁
                            span 四川履带吊
                            span 履带式起重机租赁
                        .hero-contact
                            .hero-phone
                                span 联系唐经理
                                strong= companyInfo.primaryPhone
                                small 备用：#{companyInfo.secondaryPhone} · 微信电话同号
                            +consultButtons('hero-actions')
                            a.btn.btn-outline-light.btn-xl(href='#crawler-crane')
                                i.fas.fa-list-check.me-2
                                | 查看设备吨位
                            a.btn.btn-primary.btn-xl(href='/lifting-plan')
                                i.fas.fa-calculator.me-2
                                | 吊装选型初算

        // 履带式起重机租赁
        section#crawler-crane.page-section
            .container
                .section-intro.text-center
                    h2.section-heading 重庆履带吊租赁 · 履带式起重机租赁
                    h3.section-subheading.text-muted 重庆履带吊是客户对履带式起重机的常用叫法。提供55吨至500吨多种吨位履带式起重机，面向重庆、四川、贵州等区域履带吊租赁需求。
                .equipment-feature.row.align-items-center.mb-5
                    .col-lg-5.mb-4.mb-lg-0
                        img.img-fluid.feature-img(src='assets/img/equipment/crawler-crane.jpg', alt='重庆履带吊租赁履带式起重机作业现场')
                    .col-lg-7
                        .feature-copy
                            h3 重庆履带吊租赁服务
                            p 面向重庆履带吊、履带吊租赁、四川履带吊和重庆履带式起重机租赁需求，服务渝贵川及周边区县。客户如不确定需要多大吨位，可直接联系唐经理说明吊装物重量、尺寸、作业地点和现场环境，我们协助沟通合适设备。
                            +consultButtons('dark-actions')
                .row
                    each ton in crawlerCranes
                        +equipmentCard(`${ton}履带式起重机租赁`, `${ton}起重机租赁`)
                .consult-note.mt-4
                    strong 不确定需要多大吨位？
                    | 直接联系唐经理，说明吊装物重量、尺寸、作业地点和现场环境，我们协助沟通合适设备。

        // 汽车式起重机租赁
        section#truck-crane.page-section.bg-light
            .container
                .section-intro.text-center
                    h2.section-heading 重庆吊车出租 · 汽车式起重机租赁
                    h3.section-subheading.text-muted 重庆吊车通常指汽车式起重机、汽车吊等现场常用设备。提供25吨至500吨多种吨位汽车式起重机。
                .equipment-feature.row.align-items-center.mb-5
                    .col-lg-5.mb-4.mb-lg-0
                        img.img-fluid.feature-img(src='assets/img/equipment/truck-crane.jpg', alt='重庆吊车出租汽车式起重机作业现场')
                    .col-lg-7
                        .feature-copy
                            h3 重庆吊车出租服务
                            p 面向重庆吊车、重庆吊车出租、重庆汽车吊租赁需求，可根据现场工况沟通汽车式起重机吨位。电话和微信同号，直接联系唐经理确认更快。
                            +consultButtons('dark-actions')
                .row
                    each ton in truckCranes
                        +equipmentCard(`${ton}汽车式起重机租赁`, `${ton}起重机租赁`)
                .consult-note.mt-4
                    strong 不确定需要多大吨位？
                    | 直接联系唐经理，说明吊装物重量、尺寸、作业地点和现场环境，我们协助沟通合适设备。

        // 起重参数
        section#lifting-parameters.page-section.parameters-section
            .container
                .row.align-items-center
                    .col-lg-7
                        h2.section-heading 吊装选型与起重参数
                        p.section-subheading.text-muted 客户可先提供吊重、作业高度和作业半径，生成一份用于沟通的初步吨位建议。
                        .parameters-box
                            p 已新增吊装选型初算页面，汇总汽车式起重机、履带式起重机吨位，并可根据吊重、高度、距离整理初步咨询方案。
                            p 沟通时建议说明：吊装物重量、尺寸、作业地点、作业高度、作业半径、现场环境和使用时间。
                            p.mb-0 页面输出只作为初步沟通参考，最终仍需结合起重机工况表、现场站位、地基承载、索具和安全要求复核。
                            a.btn.btn-primary.mt-3(href='/lifting-plan')
                                i.fas.fa-calculator.me-2
                                | 打开吊装选型初算
                    .col-lg-5.mt-4.mt-lg-0
                        .contact-panel.compact
                            h3 参数不确定？
                            p 直接联系唐经理，比自己估吨位更稳妥。
                            strong.panel-phone= companyInfo.primaryPhone
                            +consultButtons('dark-actions')

        // 设备展示与工程案例
        section#portfolio.page-section.bg-light
            .container
                .text-center
                    h2.section-heading 设备展示与工程案例
                    h3.section-subheading.text-muted 展示重庆履带吊、重庆吊车、履带式起重机、汽车式起重机及吊装作业现场，真实图片后续可替换。
                .row
                    each item in portfolioItems
                        .col-lg-4.col-sm-6.mb-4
                            .portfolio-item
                                a.portfolio-link(data-bs-toggle='modal', href=`#portfolioModal${item.id}`, aria-label=`查看${item.title}`)
                                    .portfolio-hover
                                        .portfolio-hover-content
                                            i.fas.fa-plus.fa-3x
                                    img.img-fluid(src=item.image, alt=item.alt)
                                .portfolio-caption
                                    .portfolio-caption-heading= item.title
                                    .portfolio-caption-subheading.text-muted= item.subtitle

        // 服务优势
        section#advantages.page-section
            .container
                .text-center
                    h2.section-heading 服务优势
                    h3.section-subheading.text-muted 主营重庆履带吊租赁、重庆吊车出租、履带式起重机租赁、汽车式起重机租赁和设备吊装，联系直接，沟通高效。
                .row.g-4
                    .col-md-6.col-lg-3
                        .advantage-card.h-100
                            i.fas.fa-weight-hanging
                            h3 多吨位设备
                            p 覆盖25吨、55吨、75吨、100吨、135吨、150吨、200吨、280吨、320吨、400吨、500吨等多种吨位。
                    .col-md-6.col-lg-3
                        .advantage-card.h-100
                            i.fas.fa-truck-ramp-box
                            h3 履带式与汽车式起重机
                            p 提供履带式起重机和汽车式起重机，可根据实际需求沟通选择。
                    .col-md-6.col-lg-3
                        .advantage-card.h-100
                            i.fas.fa-map-location-dot
                            h3 渝贵川区域服务
                            p 服务渝贵川及周边区县，位于重庆市大渡口区。
                    .col-md-6.col-lg-3
                        .advantage-card.h-100
                            i.fas.fa-phone-volume
                            h3 联系直接
                            p 电话和微信同号，客户可直接联系唐经理，不需要填写表单。

        section.page-section.seo-entry-section.bg-light(aria-labelledby='seo-entry-title')
            .container
                .text-center
                    h2#seo-entry-title.section-heading 常用起重机租赁入口
                    p.section-subheading.text-muted 按服务区域、设备类型和常用吨位查看对应租赁信息。
                nav.row.g-0.seo-entry-list(aria-label='起重机租赁相关页面')
                    each link in seoEntryLinks
                        .col-sm-6.col-lg-4
                            a.seo-entry-link(href=link[1])
                                span= link[0]
                                i.fas.fa-chevron-right(aria-hidden='true')

        // Contact
        section#contact.page-section
            .container
                .text-center
                    h2.section-heading 联系我们
                    h3.section-subheading 需要重庆履带吊、重庆吊车、履带式起重机、汽车式起重机或吊装服务？欢迎直接电话或微信联系唐经理。
                .row.g-4.align-items-stretch
                    .col-lg-7
                        .contact-panel.h-100
                            h3= companyInfo.name
                            dl.contact-list
                                dt 联系人
                                dd= companyInfo.contactPerson
                                dt 电话
                                dd
                                    a.contact-number(href=`tel:${companyInfo.primaryPhone}`, data-consult='phone')= companyInfo.primaryPhone
                                    span.mx-2 /
                                    a.contact-number.secondary(href=`tel:${companyInfo.secondaryPhone}`, data-consult='phone-secondary')= companyInfo.secondaryPhone
                                dt 微信
                                dd
                                    a.contact-number.wechat-number(href='#contact', data-copy-text=companyInfo.wechatPrimary, data-copy-label='微信号')= companyInfo.wechatPrimary
                                    span.mx-2 /
                                    a.contact-number.secondary.wechat-number(href='#contact', data-copy-text=companyInfo.wechatSecondary, data-copy-label='微信号')= companyInfo.wechatSecondary
                                    span.ms-2= companyInfo.wechatNote
                                dt 地址
                                dd= companyInfo.address
                                dt 服务区域
                                dd= companyInfo.serviceArea
                            +consultButtons('dark-actions')
                            .contact-tip
                                strong 不确定需要多大吨位？
                                | 可直接联系唐经理。咨询时建议简单说明：吊装物重量、尺寸、作业地点、作业高度、现场环境和使用时间，我们会根据实际情况沟通合适设备。
                    .col-lg-5
                        .qrcode-card.h-100#wechat-qrcode
                            img(src=companyInfo.qrcode, alt='重庆敏祥吊装租赁责任有限公司微信二维码')
                            h3 微信扫码咨询
                            p 已复制手机号后，请打开微信搜索手机号添加好友。#{companyInfo.wechatNote}。
                            .qrcode-phone= companyInfo.wechatPrimary

        // Footer
        footer.footer.py-4
            .container
                .row.align-items-center
                    .col-lg-6.text-lg-start
                        | Copyright &copy; #{companyInfo.name} 2026
                    .col-lg-6.text-lg-end
                        | 致力服务于渝贵川及周边区县

        // 移动端底部固定咨询栏
        .mobile-consult-bar
            a.mobile-consult-btn.phone(href=`tel:${companyInfo.primaryPhone}`, data-consult='phone')
                i.fas.fa-phone
                span 电话咨询
            a.mobile-consult-btn.wechat(href='#contact', data-consult='wechat')
                i.fab.fa-weixin
                span 微信咨询

        #consultToast.consult-toast(role='status', aria-live='polite')

        // 工程案例弹窗
        each item in portfolioItems
            .portfolio-modal.modal.fade(id=`portfolioModal${item.id}`, tabindex='-1', role='dialog', aria-hidden='true')
                .modal-dialog
                    .modal-content
                        .close-modal(data-bs-dismiss='modal')
                            img(src='assets/img/close-icon.svg', alt='关闭')
                        .container
                            .row.justify-content-center
                                .col-lg-8
                                    .modal-body
                                        h2.text-uppercase= item.title
                                        p.item-intro.text-muted= item.subtitle
                                        img.img-fluid.d-block.mx-auto(src=item.image, alt=item.alt)
                                        p= item.body
                                        .modal-contact-box
                                            p.mb-2
                                                strong 电话咨询：
                                                | #{companyInfo.primaryPhone} / #{companyInfo.secondaryPhone}
                                            p.mb-3
                                                strong 微信咨询：
                                                | 微信电话同号，扫码添加微信
                                            +consultButtons('dark-actions justify-content-center')
                                        button.btn.btn-primary.btn-xl.text-uppercase(data-bs-dismiss='modal', type='button')
                                            i.fas.fa-xmark.me-1
                                            | 关闭

        // Bootstrap core JS
        script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js')

        // Core theme JS
        script(src='js/scripts.js?v=20260526-planner-submit')
